# OnePlus 8T (kebab, SM8250/kona): device node permissions normally applied by Android's ueventd.
# On Ubuntu Touch the HOST udev creates the nodes, so without these the GPU (/dev/kgsl-3d0) and the
# graphics allocator (/dev/ion) are root-only and every non-root EGL user (the Lomiri shell as phablet, the
# greeter as lightdm) crashes inside Android's libEGL (strstr on a garbage extension string).
# Replaces the empty stub /usr/lib/udev/rules.d/70-android.rules through the Halium overlay.
# Based on the UBports xiaomi-vayu / sony-pdx225 rules; only nodes this kernel actually has, root:root 0666
# where non-root users need access. Extend per subsystem (camera, modem, audio, sensors) as they are brought up.

# Graphics / GPU / memory
ACTION=="add", KERNEL=="kgsl", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="kgsl-3d0", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="kgsl-2d0", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="kgsl-2d1", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="hgsl", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="ion", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="genlock", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="membuf", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", SUBSYSTEM=="drm", KERNEL=="card*", MODE="0666"
ACTION=="add", SUBSYSTEM=="drm", KERNEL=="renderD*", MODE="0666"
ACTION=="add", KERNEL=="ashmem*", OWNER="root", GROUP="root", MODE="0666"
