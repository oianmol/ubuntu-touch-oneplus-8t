# halium.config — defconfig fragment merged on top of vendor/kona-perf_defconfig + vendor/oplus.config.
# DRAFT 2026-11-20 for the 4.19.325 LineageOS sm8250 kernel. NOT yet checked against the real merged
# .config: after the first build, run Halium's check-config / diff against `make olddefconfig` output
# and drop anything already set or that does not exist on 4.19.
#
# Not GKI, so there is no KMI to preserve and no task_struct patch is needed for SYSVIPC (unlike q5q).
# Vendor kernel modules in the PE vendor partition are matched by vermagic, so keep
# CONFIG_MODVERSIONS / LOCALVERSION unchanged from the defconfig or modules will refuse to load.

# --- toolchain: the stock defconfig sets CC_WERROR=y; the clang the build tools pick for Halium 13
#     (r450784e) emits warnings this 4.19 kernel never saw (e.g. -Wgnu-variable-sized-type-not-at-end) ---
# CONFIG_CC_WERROR is not set

# --- core: device nodes, file handles, ttys -------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- IPC ------------------------------------------------------------------
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- namespaces: lxc (Android container) + systemd -------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y

# --- cgroups for lxc/systemd (many are already on in Android kernels) -----
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y

# --- Android binder: Halium needs binderfs for container HAL binders ------
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# --- autofs (systemd automount), squashfs (UT system-image / clicks) ------
CONFIG_AUTOFS4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZSTD=y

# --- netfilter/bridge basics UT networking uses (verify against defconfig) -
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_TUN=y

# --- AppArmor: UT confines apps; keep SELinux for the Android HALs --------
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# kona-perf_defconfig sets this to 0, which makes the kernel print "AppArmor disabled by boot time
# parameter" with no such parameter given (seen on the 8T via the Halium telnet shell, 2026-11-21).
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
# Note: 4.19 has no CONFIG_LSM string stacking for apparmor+selinux; if both cannot be enabled,
# check `security=` / CONFIG_DEFAULT_SECURITY on this branch first and adapt.

# --- USB gadget functions: Halium's initramfs debug network (scripts/panic/telnet) builds a configfs gadget
#     with rndis.usb0, and Ubuntu Touch usb-moded switches between rndis/ecm/acm. The stock kernel has only
#     NCM (+ MTP/PTP/ADB), so none of these existed. ---
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y

# --- Bluetooth: bluebinder bridges the Android HIDL Bluetooth HAL to BlueZ through a virtual HCI controller
#     (/dev/vhci). The stock config has BT=y but no HCIVHCI, so bluebinder exits with "No such device" in a loop and
#     there is no hci0. RFCOMM/BNEP/HIDP are the classic profiles BlueZ expects (serial/HFP, PAN tethering, HID). ---
CONFIG_BT_HCIVHCI=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
