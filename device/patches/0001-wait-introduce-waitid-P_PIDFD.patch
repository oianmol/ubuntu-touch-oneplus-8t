+/**
+ * pidfd_get_pid() - Get a pid reference from a pidfd.
+ * @fd: the pidfd
+ *
+ * Backport of the 5.4 helper. Returns a referenced struct pid, or an ERR_PTR.
+ */
+struct pid *pidfd_get_pid(unsigned int fd)
+{
+	struct fd f;
+	struct pid *pid;
+
+	f = fdget(fd);
+	if (!f.file)
+		return ERR_PTR(-EBADF);
+
+	if (f.file->f_op != &pidfd_fops) {
+		fdput(f);
+		return ERR_PTR(-EBADF);
+	}
+
+	pid = get_pid(f.file->private_data);
+	fdput(f);
+	return pid;
+}
